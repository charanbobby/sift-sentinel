# --- Secrets ---
.env
.env.*
!.env.example
*.key
*.pem
*credentials*

# --- Forensic evidence (large binary, do NOT commit) ---
# Whitelist approach for HACKATHON-2026/: ignore EVERYTHING in the evidence tree,
# then opt back in only markdown/text/manifest files so folder structure & context
# stay tracked. Safer than an extension blacklist — new binary formats can't leak.
HACKATHON-2026/**
!HACKATHON-2026/
!HACKATHON-2026/**/
!HACKATHON-2026/**/*.md
!HACKATHON-2026/**/*.txt
!HACKATHON-2026/**/.gitkeep
!HACKATHON-2026/**/README*
!HACKATHON-2026/**/CHALLENGE*
!HACKATHON-2026/**/MANIFEST*

# Belt-and-suspenders: ignore common evidence binary extensions anywhere in the tree
# (in case future evidence lands outside HACKATHON-2026/).
*.E01
*.e01
*.E[0-9][0-9]
*.e[0-9][0-9]
*.Ex[0-9][0-9]
*.aff
*.aff4
*.ad1
*.l01
*.dd
*.raw
*.img
*.iso
*.001
*.002
*.003
*.vmdk
*.vmem
*.mem
*.lime
*.hve
*.evtx
*.pcap
*.pcapng
*.pf
HACKATHON-2026/base-wkstn-05-memory/
HACKATHON-2026/base-mail-memory/
HACKATHON-2026/*-memory/

# --- Pipeline run artifacts (reproducible, keep folder via .gitkeep) ---
experiments/*/out/*
!experiments/*/out/.gitkeep
# Ground-truth annotations are authored artifacts, not reproducible outputs — track them.
# Pattern order matters: un-ignore parent dirs, then re-ignore everything inside them,
# then carve out only ground_truth.* files.
!experiments/*/out/runs/
!experiments/*/out/runs/*/
experiments/*/out/runs/*/*
!experiments/*/out/runs/*/ground_truth.json
!experiments/*/out/runs/*/ground_truth.md
!experiments/*/out/runs/*/pre-step-0/
experiments/*/out/runs/*/pre-step-0/*
!experiments/*/out/runs/*/pre-step-0/ground_truth.json
!experiments/*/out/runs/*/pre-step-0/ground_truth.md

# --- Claude Code memory (junctioned to D:\ for portability; see docs/setup/portable-memory-setup.md) ---
.claude-memory/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# --- uv ---
# Keep uv.lock committed for reproducibility (do NOT ignore).

# --- Jupyter ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Editors / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs / tmp ---
*.log
logs/
tmp/
.tmp/

# --- Ephemeral session file (per workflow: _resume.md is rewritten each break) ---
_resume.md

# --- Project-local Claude Code state (settings + lock files specific to this checkout) ---
.claude/

# --- Private correspondence drafts (keep locally, don't publish) ---
docs/onboarding/invite-email.md
